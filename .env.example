# Copy this file to .env and fill in your own database connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Secret that signs admin session cookies. Generate a long random string (e.g. openssl rand -base64 32).
# REQUIRED in production: set it in Vercel (Settings > Environment Variables) for Production + Preview.
SESSION_SECRET="change-me-to-a-long-random-string"
