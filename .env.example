# Gomodi Guest Lodge — canonical environment template
#
# Copy this file to `.env.local` (local dev) or paste the keys into your
# hosting environment (Vercel) and the GitHub repo settings (CI secrets).
# Never commit real values — `.env` and `.env.*` are gitignored.
#
#   cp .env.example .env.local
#
# Sections below:
#   1. Required — the app cannot start without these
#   2. Required in production
#   3. Optional — the app degrades gracefully without them (fail-open)
#   4. WhatsApp Business Cloud API (go-live)
#   5. Never put these in a .env file
#
# See SETUP-LOCAL.md for the local setup walkthrough.

# ---------------------------------------------------------------------------
# 1. Required
# ---------------------------------------------------------------------------

# Postgres connection string (Neon recommended). Used by the runtime pool
# (lib/db/index.ts), drizzle-kit (drizzle.config.ts), migrations and the
# adoption script (scripts/adopt-migrations.ts).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# ---------------------------------------------------------------------------
# 2. Required in production
# ---------------------------------------------------------------------------

# Secret that signs admin session cookies (HMAC-SHA256). Generate a long
# random string, e.g. `openssl rand -base64 32`. Hard-fails in production
# if missing; dev falls back to a constant so local logins work out of the
# box. Set it in Vercel (Production + Preview) — never commit it.
SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# 3. Optional — the app degrades gracefully without them
# ---------------------------------------------------------------------------

# Vercel Blob read/write token — required for proof-of-payment uploads
# (/api/upload, @vercel/blob). Without it, uploads return an error.
# Create a store in the Vercel dashboard and paste the token.
BLOB_READ_WRITE_TOKEN=""

# Global sliding-window rate limiting (Upstash Redis REST). Without these,
# the middleware falls back to a per-instance in-memory limiter — fine in
# dev, weaker under multiple instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry error monitoring. The SDK is a no-op (fails open) without a DSN —
# local dev and CI never need these.
SENTRY_DSN=""                    # server + edge runtimes (and client fallback)
NEXT_PUBLIC_SENTRY_DSN=""        # browser bundle (public by design)
SENTRY_AUTH_TOKEN=""             # build-time source-map upload; skip locally

# Public origin of the deployed site, used by middleware.ts to allow the
# canonical origin through the CSRF check (behind proxies/load balancers)
# and as the fallback base for quote share links. Falls back to
# http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=""

# ---------------------------------------------------------------------------
# 4. WhatsApp Business Cloud API (Meta) — go-live
# ---------------------------------------------------------------------------
# All sends fail open and log visibly until the first three keys are set.
# Templates must be created + approved in Meta Business Manager and match
# the names below (or override them).

WHATSAPP_TOKEN=""                # permanent access token (not the 24h one)
WHATSAPP_PHONE_NUMBER_ID=""      # numeric ID of the business WhatsApp number
WHATSAPP_RECIPIENT=""            # E.164 number that receives booking alerts (lodge)

# Optional overrides (defaults shown)
WHATSAPP_OTP_TEMPLATE="gomodi_otp"
WHATSAPP_ALERT_TEMPLATE="gomodi_booking_alert"
WHATSAPP_STATUS_TEMPLATE="gomodi_booking_status"
WHATSAPP_QUOTE_TEMPLATE="gomodi_quote_link"
WHATSAPP_REVIEW_TEMPLATE="gomodi_review_request"
WHATSAPP_LANGUAGE="en"

# ---------------------------------------------------------------------------
# 5. Never put these in a .env file
# ---------------------------------------------------------------------------

# NODE_ENV — managed by Next.js. Setting it in .env/.env.local breaks
# `next build` (known project gotcha). Leave it unset.
#
# NEON_API_KEY, NEON_PROJECT_ID — GitHub Actions only (repo secret/variable,
# used by the Neon preview-branch + autosuspend workflows). Set them in
# GitHub → Settings → Secrets and variables → Actions.
#
# E2E_REVIEW_TOKEN — CI-only secret that enables the review-form Playwright
# spec. Set it as a GitHub Actions secret if you want that spec to run.
